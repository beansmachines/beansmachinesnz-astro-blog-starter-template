---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h3 class="accent" style="text-align: center;">BeansMachines</h3>
			<h5 class="accent" style="text-align: center;">presents</h5>
			<h1 class="accent">Electric Moon</h1>
			<!-- <h2 class="accent">In development Jan 2026, check back soon 😊</h1> -->
			<a href="/products/electric-moon-80">
    			<img class="boxshadow" src="/public/images/electric-moon-80-animation.webp" alt="Electric Moon">
			</a>
			<h1 class="wide-heading"> A minature Electric Moon</h1>
			<h1 class="wide-heading"> that works in sync with nature</h1>
			<p>
				BeansMachines is launching it's first product, the <a href="/products/electric-moon-80">Electric Moon</a>. 
				It lights up perfectly in sync with the real moon, bringing you closer to nature.
				After a year in development, it's now ready for you to enjoy.
			</p>
			<p>
				Check back here soon for more inspiring things being cooked up in the BeansMachines lab.
			</p>
		</main>
		<Footer />
	</body>
</html>
